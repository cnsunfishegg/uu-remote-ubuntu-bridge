#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

environment_file="$HOME/.config/uu-remote-bridge/environment"
config_dir="$HOME/.config/uu-remote-bridge"
bridge_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-console"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/uu-remote-console"
bridge_xauthority_file="$bridge_runtime_dir/Xauthority"
bridge_display_file="$bridge_runtime_dir/private-display"
controller_display_file="$bridge_runtime_dir/controller-display"
bridge_focus_file="$bridge_runtime_dir/console-focus"
window_lock_file="$runtime_dir/window.lock"
controller_state_file="$runtime_dir/controller.state"
presentation_request_file="$runtime_dir/presentation.request"
script_path="$(readlink -f "$0")"
systemctl_user=(
    /usr/bin/env
    "DBUS_SESSION_BUS_ADDRESS=unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    /usr/bin/systemctl --user
)

saved_setting() {
    local name="$1"

    [[ -f "$environment_file" ]] || return 0
    /usr/bin/sed -n "s/^${name}=//p" "$environment_file" | \
        /usr/bin/tail -n 1
}

saved_vnc_port="$(saved_setting UURB_CONSOLE_VNC_PORT)"
saved_web_port="$(saved_setting UURB_CONSOLE_WEB_PORT)"
vnc_port="${UURB_CONSOLE_VNC_PORT:-${saved_vnc_port:-5920}}"
web_port="${UURB_CONSOLE_WEB_PORT:-${saved_web_port:-6080}}"
relay_vnc_port="${UURB_RELAY_VNC_PORT:-5922}"
relay_vnc_auth_file="${UURB_RELAY_VNC_AUTH_FILE:-$config_dir/relay-vnc.pass}"
novnc_root="${UURB_NOVNC_ROOT:-/usr/share/novnc}"
controller_fullscreen="${UURB_CONTROLLER_FULLSCREEN:-auto}"
controller_fullscreen_value=0
console_url="http://127.0.0.1:$web_port/vnc.html?autoconnect=1&resize=scale&reconnect=1"
bridge_display=""
bridge_xauthority=""
vnc_pid=""
websockify_pid=""
window_vnc_pid=""
window_monitor_pid=""
window_focus_pid=""
window_remote_channel=""
relay_focus_pid=""

notify_error() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send 'UU Remote' "$1"
    fi
    printf '%s\n' "$1" >&2
}

trace_controller_timing() {
    [[ -d "$state_dir" ]] || /usr/bin/install -d -m 0700 "$state_dir"
    printf '%s pid=%s %s\n' "${EPOCHREALTIME:-0}" "$BASHPID" "$*" \
        >>"$state_dir/window-timing.log"
}

valid_port() {
    [[ "$1" =~ ^[1-9][0-9]{3,4}$ ]] &&
        ((10#$1 >= 1024 && 10#$1 <= 65535))
}

if ! valid_port "$vnc_port" || ! valid_port "$web_port" ||
   ! valid_port "$relay_vnc_port" ||
   [[ "$vnc_port" == "$web_port" ||
      "$vnc_port" == "$relay_vnc_port" ||
      "$web_port" == "$relay_vnc_port" ]]; then
    printf 'UU console ports must be distinct integers from 1024 through 65535.\n' \
        >&2
    exit 2
fi
vnc_port=$((10#$vnc_port))
web_port=$((10#$web_port))
relay_vnc_port=$((10#$relay_vnc_port))
case "$controller_fullscreen" in
    auto|on|off) ;;
    *)
        printf 'UURB_CONTROLLER_FULLSCREEN must be auto, on, or off.\n' >&2
        exit 2
        ;;
esac

display_ready() {
    local display="$1"
    local xauthority="$2"

    [[ "$display" =~ ^:(0|[1-9][0-9]{0,2})(\.1)?$ ]] &&
        [[ -r "$xauthority" ]] &&
        /usr/bin/env DISPLAY="$display" XAUTHORITY="$xauthority" \
            /usr/bin/xdpyinfo >/dev/null 2>&1
}

discover_bridge() {
    local -a arguments=()
    local auth=""
    local candidate=""
    local index
    local pid

    bridge_display=""
    bridge_xauthority=""
    if [[ -r "$bridge_display_file" ]]; then
        read -r candidate <"$bridge_display_file" || true
        if display_ready "$candidate" "$bridge_xauthority_file"; then
            bridge_display="$candidate"
            bridge_xauthority="$bridge_xauthority_file"
            return 0
        fi
    fi

    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        arguments=()
        if ! mapfile -d '' -t arguments <"/proc/$pid/cmdline"; then
            continue
        fi
        candidate=""
        auth=""
        for ((index = 1; index < ${#arguments[@]}; index++)); do
            if [[ "${arguments[index]}" =~ ^:(0|[1-9][0-9]{0,2})$ ]]; then
                candidate="${arguments[index]}"
            elif [[ "${arguments[index]}" == -auth &&
                    $((index + 1)) -lt ${#arguments[@]} ]]; then
                auth="${arguments[index + 1]}"
                index=$((index + 1))
            fi
        done
        if [[ "$auth" == "$bridge_xauthority_file" ]] &&
           display_ready "$candidate" "$auth"; then
            bridge_display="$candidate"
            bridge_xauthority="$auth"
            return 0
        fi
    done < <(/usr/bin/pgrep -u "$UID" -x Xvfb || true)
    return 1
}

listener_present() {
    /usr/bin/ss -H -ltn "sport = :$1" 2>/dev/null | \
        /usr/bin/grep -q .
}

discover_controller() {
    local candidate=""
    discover_bridge || return 1
    if [[ -r "$controller_display_file" ]]; then
        read -r candidate <"$controller_display_file" || return 1
        [[ "$candidate" == "$bridge_display.1" ]] || return 1
        display_ready "$candidate" "$bridge_xauthority_file" || return 1
        bridge_display="$candidate"
    fi
}

wait_for_bridge() {
    for _ in {1..160}; do
        if discover_bridge; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

find_client_window() {
    local active=""
    local best=""
    local best_score=-1
    local geometry=""
    local height=0
    local score=0
    local state=""
    local window
    local width=0

    discover_controller || return 1
    active="$(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool getactivewindow 2>/dev/null || true
    )"
    while read -r window; do
        state="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xprop -id "$window" WM_STATE \
                    _NET_WM_WINDOW_TYPE WM_TRANSIENT_FOR \
                    2>/dev/null || true
        )"
        [[ "$state" == *'WM_STATE(WM_STATE)'* ]] || continue
        # UU's exit confirmation is an opaque, screen-sized transient Wine
        # window.  It is an overlay for the remote canvas, never a new scene.
        # Selecting it here replaces the remote picture with its black fill.
        [[ "$state" != *'_NET_WM_WINDOW_TYPE_DIALOG'* &&
           "$state" != *'WM_TRANSIENT_FOR(WINDOW)'* ]] || continue
        geometry="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowgeometry "$window" 2>/dev/null || true
        )"
        [[ "$geometry" =~ Geometry:[[:space:]]*([0-9]+)x([0-9]+) ]] || continue
        width="${BASH_REMATCH[1]}"
        height="${BASH_REMATCH[2]}"
        # Ignore toasts, DXGI helpers, and tiny GameViewer utility windows.
        ((width >= 400 && height >= 300)) || continue
        # UU can name a remote-session window after a device. Do not hardcode
        # that private title: prefer the visible full-size application window.
        score=$((width * height))
        [[ "$state" == *'window state: Normal'* ]] &&
            score=$((score + 2000000))
        [[ "$window" == "$active" ]] &&
            score=$((score + 10000000))
        if ((score > best_score)); then
            best="$window"
            best_score="$score"
        fi
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --class 'gameviewer.exe' 2>/dev/null ||
            true
    )
    [[ -z "$best" ]] || printf '%s\n' "$best"
}

find_scene_window() {
    local active=""
    local best=""
    local best_score=-1
    local geometry=""
    local height=0
    local score=0
    local state=""
    local window
    local width=0

    [[ "${1:-}" == --known-display ]] || discover_controller || return 1
    active="$(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool getactivewindow 2>/dev/null || true
    )"
    while read -r window; do
        state="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xprop -id "$window" WM_STATE \
                    _NET_WM_WINDOW_TYPE WM_TRANSIENT_FOR \
                    2>/dev/null || true
        )"
        [[ "$state" == *'WM_STATE(WM_STATE)'* ]] || continue
        [[ "$state" != *'_NET_WM_WINDOW_TYPE_DIALOG'* &&
           "$state" != *'WM_TRANSIENT_FOR(WINDOW)'* ]] || continue
        geometry="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowgeometry "$window" 2>/dev/null || true
        )"
        [[ "$geometry" =~ Geometry:[[:space:]]*([0-9]+)x([0-9]+) ]] || continue
        width="${BASH_REMATCH[1]}"
        height="${BASH_REMATCH[2]}"
        ((width >= 400 && height >= 300)) || continue
        score=$((width * height))
        # Prefer a visible UU surface over a larger stale/iconified session.
        [[ "$state" == *'window state: Normal'* ]] &&
            score=$((score + 100000000))
        # The launcher remains mapped behind an active remote session.  If UU
        # deliberately activates it again, treat that as a scene change so
        # the host/device list can return inside the same outer shell.
        [[ "$window" == "$active" ]] &&
            score=$((score + 1000000000))
        if ((score > best_score)); then
            best="$window"
            best_score="$score"
        fi
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --class 'gameviewer.exe' 2>/dev/null ||
            true
    )
    [[ -z "$best" ]] || printf '%s\n' "$best"
}

find_management_window() {
    local geometry=""
    local height=0
    local name=""
    local state=""
    local window=""
    local width=0

    [[ "${1:-}" == --known-display ]] || discover_controller || return 1
    while read -r window; do
        name="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowname "$window" 2>/dev/null || true
        )"
        case "$name" in
            '网易UU远程'|'UU Remote'|'NetEase UU Remote') ;;
            *) continue ;;
        esac
        state="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xprop -id "$window" WM_STATE 2>/dev/null || true
        )"
        [[ "$state" == *'WM_STATE(WM_STATE)'* ]] || continue
        geometry="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowgeometry "$window" 2>/dev/null || true
        )"
        [[ "$geometry" =~ Geometry:[[:space:]]*([0-9]+)x([0-9]+) ]] || continue
        width="${BASH_REMATCH[1]}"
        height="${BASH_REMATCH[2]}"
        ((width >= 400 && height >= 300)) || continue
        printf '%s\n' "$window"
        return 0
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --class 'gameviewer.exe' 2>/dev/null ||
            true
    )
    return 1
}

find_remote_scene_candidate() {
    local management="$1"
    local active=""
    local best="" best_score=-1 candidate_score=0 candidate=""
    local geometry="" height="" width=""
    local properties=""

    active="$(/usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
        getactivewindow 2>/dev/null || true)"
    while read -r candidate; do
        [[ "$candidate" =~ ^[1-9][0-9]*$ &&
           "$candidate" != "$management" ]] || continue
        properties="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop -id "$candidate" \
            WM_STATE _NET_WM_WINDOW_TYPE WM_TRANSIENT_FOR \
            2>/dev/null || true)"
        [[ "$properties" == *'window state: Normal'* &&
           "$properties" == *'_NET_WM_WINDOW_TYPE_NORMAL'* &&
           "$properties" != *'WM_TRANSIENT_FOR(WINDOW)'* ]] || continue
        geometry="$(private_window_geometry "$candidate" || true)"
        width="$(/usr/bin/sed -n 's/^WIDTH=//p' <<<"$geometry")"
        height="$(/usr/bin/sed -n 's/^HEIGHT=//p' <<<"$geometry")"
        [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || continue
        ((width >= 400 && height >= 300)) || continue
        candidate_score=$((width * height))
        if [[ "$candidate" == "$active" ]]; then
            candidate_score=$((candidate_score + 100000000))
        fi
        if ((candidate_score > best_score)); then
            best="$candidate"
            best_score="$candidate_score"
        fi
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
            search --class 'gameviewer.exe' \
            2>/dev/null || true
    )
    [[ -z "$best" ]] || printf '%s\n' "$best"
}

maximize_private_remote_scene() {
    local window="$1" screen_width="$2" screen_height="$3"
    local geometry="" width="" height=""
    local minimum_width=0 minimum_height=0

    [[ "$window" =~ ^[1-9][0-9]*$ &&
       "$screen_width" =~ ^[1-9][0-9]*$ &&
       "$screen_height" =~ ^[1-9][0-9]*$ ]] || return 1
    minimum_width=$((screen_width > 64 ? screen_width - 64 : screen_width))
    minimum_height=$((screen_height > 64 ? screen_height - 64 : screen_height))
    /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
        /usr/bin/wmctrl -ir "$(printf '0x%x' "$window")" -b \
        add,maximized_vert,maximized_horz >/dev/null 2>&1 || return 1
    /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
        /usr/bin/xdotool windowmap "$window" windowactivate "$window" \
        >/dev/null 2>&1 || true
    for _ in {1..10}; do
        geometry="$(private_window_geometry "$window" || true)"
        width="$(/usr/bin/sed -n 's/^WIDTH=//p' <<<"$geometry")"
        height="$(/usr/bin/sed -n 's/^HEIGHT=//p' <<<"$geometry")"
        if [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] &&
           ((width >= minimum_width && height >= minimum_height)); then
            trace_controller_timing \
                "remote scene maximized window=$window ${width}x${height}"
            return 0
        fi
        sleep 0.02
    done
    trace_controller_timing \
        "remote scene maximize incomplete window=$window ${width:-0}x${height:-0}"
    return 1
}

controller_remote_session_active() {
    local management=""
    local scene=""
    local state=""

    discover_controller || return 1
    management="$(find_management_window --known-display || true)"
    scene="$(find_scene_window --known-display | /usr/bin/tail -n 1)"
    [[ -n "$management" && -n "$scene" && "$scene" != "$management" ]] ||
        return 1
    state="$(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xprop -id "$scene" WM_STATE 2>/dev/null || true
    )"
    [[ "$state" == *'window state: Normal'* ]]
}

controller_management_scene_active() {
    local management=""
    local scene=""

    discover_controller || return 1
    management="$(find_management_window --known-display || true)"
    scene="$(find_scene_window --known-display | /usr/bin/tail -n 1)"
    [[ -n "$management" && "$scene" == "$management" ]]
}

presentation_mode_for_scene() {
    local candidate="$1"
    local management="$2"
    local width="$3"
    local height="$4"
    local source_fullscreen="$5"

    case "$controller_fullscreen" in
        on)
            printf 'fullscreen\n'
            return 0
            ;;
        off)
            printf 'windowed\n'
            return 0
            ;;
    esac
    # The launcher/device list remains a normal application window even if
    # UU retained an old maximize flag. A real remote surface gets its own
    # freshly-created native full-screen viewer so no launcher scale leaks
    # into the peer desktop.
    if [[ -n "$management" && "$candidate" == "$management" ]]; then
        printf 'windowed\n'
    elif [[ "$source_fullscreen" == true ]] ||
         { [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] &&
           ((width >= 1200 && height >= 700)); }; then
        printf 'fullscreen\n'
    else
        printf 'windowed\n'
    fi
}

find_relay_window() {
    local candidate=""
    local name=""
    local relay=""
    discover_bridge || return 1
    relay="$(
        /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --onlyvisible \
                --name '^Ubuntu-Desktop-Relay$' 2>/dev/null | \
            /usr/bin/tail -n 1 || true
    )"
    if [[ -z "$relay" ]]; then
        while read -r candidate; do
            name="$(
                /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/xdotool getwindowname "$candidate" \
                        2>/dev/null || true
            )"
            [[ "$name" == *' - TigerVNC' ]] && relay="$candidate"
        done < <(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool search --class 'TigerVNC Viewer' \
                    2>/dev/null || true
        )
    fi
    if [[ -z "$relay" ]]; then
        while read -r candidate; do
            name="$(
                /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/xdotool getwindowname "$candidate" \
                        2>/dev/null || true
            )"
            if [[ "$name" =~ ^127\.0\.0\.1:.*\ -\ RealVNC\ Viewer$ ]]; then
                relay="$candidate"
            fi
        done < <(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool search --class 'realvnc-vncviewer' \
                    2>/dev/null || true
        )
    fi
    [[ -n "$relay" ]] || return 1
    printf '%s\n' "$relay"
}

focus_client() {
    local client_window=""
    local relay_window=""

    discover_controller || return 1
    if [[ -r "$controller_display_file" ]]; then
        # Never hide or acquire the host's focus lease for an independent
        # controller display.
        client_window="$(find_client_window | /usr/bin/tail -n 1)"
        [[ -n "$client_window" ]] || return 1
        /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowmap "$client_window" \
            windowactivate --sync "$client_window" >/dev/null 2>&1 || true
        return 0
    fi
    /usr/bin/install -d -m 0700 "$bridge_runtime_dir"
    printf '%s\n' "$$" >"$bridge_focus_file"
    chmod 0600 "$bridge_focus_file"
    # Never leave the physical-desktop relay behind the local controller.
    # The physical desktop contains this TigerVNC window, so exposing that
    # relay during a UU window transition creates an infinite mirror loop.
    relay_window="$(find_relay_window || true)"
    if [[ -n "$relay_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowminimize "$relay_window" \
                >/dev/null 2>&1 || true
    fi
    client_window="$(find_client_window | /usr/bin/tail -n 1)"
    if [[ -n "$client_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowmap "$client_window" \
                windowactivate --sync "$client_window" >/dev/null 2>&1 || true
    fi
}

release_client() {
    local client_window=""
    local relay_window=""

    rm -f "$bridge_focus_file"
    # An independent controller cannot cover the host relay; leave its Qt
    # backing store mapped so reopening never revives an empty surface.
    if [[ -r "$controller_display_file" ]]; then
        return 0
    fi
    discover_bridge || return 0
    client_window="$(find_client_window | /usr/bin/tail -n 1)"
    if [[ -n "$client_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowminimize "$client_window" \
                >/dev/null 2>&1 || true
    fi
    relay_window="$(find_relay_window || true)"
    if [[ -n "$relay_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowmap "$relay_window" \
                windowactivate "$relay_window" \
                >/dev/null 2>&1 || true
    fi
}

cleanup_server() {
    local pid

    trap - EXIT INT TERM HUP
    for pid in "$websockify_pid" "$vnc_pid"; do
        if [[ -n "$pid" ]]; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    done
    release_client || true
    rm -f "$runtime_dir/url" "$runtime_dir/display"
}

cleanup_window() {
    trace_controller_timing 'cleanup begin'
    trap - EXIT INT TERM HUP
    stop_window_child "$window_focus_pid"
    stop_window_child "$window_monitor_pid"
    stop_window_child "$window_vnc_pid"
    release_client || true
    rm -f "$runtime_dir/window.port" "$controller_state_file" \
        "$presentation_request_file"
    trace_controller_timing 'cleanup end'
}

stop_window_child() {
    local pid="$1"
    local process_state=""
    local stat_line=""

    [[ -n "$pid" ]] || return 0
    trace_controller_timing "stop child begin pid=$pid"
    kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
        kill -0 "$pid" >/dev/null 2>&1 || break
        # A completed background job remains visible to kill -0 as a zombie
        # until this parent calls wait. Treat it as stopped immediately;
        # otherwise every presentation handoff pays the full two-second
        # timeout even though both the monitor and transport already exited.
        if [[ -r "/proc/$pid/stat" ]]; then
            IFS= read -r stat_line <"/proc/$pid/stat" || stat_line=""
            process_state="${stat_line##*) }"
            process_state="${process_state%% *}"
            [[ "$process_state" == Z || "$process_state" == X ]] && break
        fi
        sleep 0.1
    done
    if kill -0 "$pid" >/dev/null 2>&1 &&
       [[ "$process_state" != Z && "$process_state" != X ]]; then
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    wait "$pid" 2>/dev/null || true
    trace_controller_timing "stop child end pid=$pid state=${process_state:-gone}"
}

publish_controller_state() {
    local generation="$1" lifecycle="$2" candidate="$3"
    local capture_mode="$4" capture_window="$5" overlay="$6"
    local x="$7" y="$8" width="$9" height="${10}" scale="${11}"
    local viewer="${12}" source_maximized="${13}" viewer_maximized="${14}"
    local temporary=""

    /usr/bin/install -d -m 0700 "$runtime_dir"
    temporary="$(/usr/bin/mktemp "$runtime_dir/.controller.state.XXXXXX")"
    {
        printf 'schema=1\n'
        printf 'generation=%s\n' "$generation"
        printf 'lifecycle=%s\n' "$lifecycle"
        printf 'candidate_window=%s\n' "${candidate:-0}"
        printf 'capture_mode=%s\n' "${capture_mode:-none}"
        printf 'capture_window=%s\n' "${capture_window:-0}"
        printf 'overlay_window=%s\n' "${overlay:-0}"
        printf 'source_x=%s\n' "${x:-0}"
        printf 'source_y=%s\n' "${y:-0}"
        printf 'source_width=%s\n' "${width:-0}"
        printf 'source_height=%s\n' "${height:-0}"
        printf 'scale=%s\n' "${scale:-0}"
        printf 'viewer_window=%s\n' "${viewer:-0}"
        printf 'source_maximized=%s\n' "$source_maximized"
        printf 'viewer_maximized=%s\n' "$viewer_maximized"
        printf 'presentation_mode=%s\n' "${presentation_mode:-unknown}"
    } >"$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$controller_state_file"
}

private_window_geometry() {
    # xdotool getwindowgeometry adds Openbox's decoration offset a second
    # time. x11vnc -clip needs the actual root coordinates of the client.
    /usr/bin/env LC_ALL=C DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
        /usr/bin/xwininfo -id "$1" -stats 2>/dev/null | /usr/bin/awk '
            /Absolute upper-left X:/ { x = $NF }
            /Absolute upper-left Y:/ { y = $NF }
            /^  Width:/ { w = $NF }
            /^  Height:/ { h = $NF }
            END {
                if (x != "" && y != "" && w != "" && h != "")
                    printf "X=%s\nY=%s\nWIDTH=%s\nHEIGHT=%s\n", x, y, w, h
            }'
}

find_private_overlay() {
    local scene="$1" scene_x="$2" scene_y="$3"
    local scene_width="$4" scene_height="$5"
    local active="" active_class="" candidate=""
    local best="" best_score=-1 candidate_score=0 is_overlay=false
    local overlay_ewmh="" overlay_geometry="" overlay_state=""
    local overlay_type=""
    local overlay_transient="" transient_target=0
    local overlay_x="" overlay_y="" overlay_width="" overlay_height=""

    [[ "$scene_x" =~ ^-?[0-9]+$ && "$scene_y" =~ ^-?[0-9]+$ &&
       "$scene_width" =~ ^[0-9]+$ && "$scene_height" =~ ^[0-9]+$ ]] || return 1
    active="$(/usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
        getactivewindow 2>/dev/null || true)"
    while read -r candidate; do
        [[ "$candidate" =~ ^[0-9]+$ && "$candidate" != "$scene" ]] ||
            continue
        active_class="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" WM_CLASS 2>/dev/null || true)"
        [[ "${active_class,,}" == *'"gameviewer.exe"'* ]] || continue
        overlay_state="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" WM_STATE 2>/dev/null || true)"
        [[ "$overlay_state" == *'window state: Normal'* ]] || continue
        overlay_geometry="$(private_window_geometry "$candidate" || true)"
        overlay_x="$(/usr/bin/sed -n 's/^X=//p' <<<"$overlay_geometry")"
        overlay_y="$(/usr/bin/sed -n 's/^Y=//p' <<<"$overlay_geometry")"
        overlay_width="$(/usr/bin/sed -n 's/^WIDTH=//p' <<<"$overlay_geometry")"
        overlay_height="$(/usr/bin/sed -n 's/^HEIGHT=//p' <<<"$overlay_geometry")"
        [[ "$overlay_x" =~ ^-?[0-9]+$ && "$overlay_y" =~ ^-?[0-9]+$ &&
           "$overlay_width" =~ ^[0-9]+$ && "$overlay_height" =~ ^[0-9]+$ ]] ||
            continue
        ((overlay_x < scene_x + scene_width &&
          overlay_x + overlay_width > scene_x &&
          overlay_y < scene_y + scene_height &&
          overlay_y + overlay_height > scene_y)) || continue

        overlay_ewmh="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" _NET_WM_STATE 2>/dev/null || true)"
        overlay_type="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" _NET_WM_WINDOW_TYPE 2>/dev/null || true)"
        overlay_transient="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" WM_TRANSIENT_FOR 2>/dev/null || true)"
        is_overlay=false
        candidate_score=$((overlay_width * overlay_height))
        if [[ "$candidate" == "$active" ]]; then
            is_overlay=true
            candidate_score=$((candidate_score + 100000000))
        fi
        if [[ "$overlay_ewmh" == *'_NET_WM_STATE_ABOVE'* ]]; then
            is_overlay=true
            candidate_score=$((candidate_score + 50000000))
        fi
        if [[ "$overlay_transient" =~ window[[:space:]]id[[:space:]]#[[:space:]](0x[0-9a-fA-F]+|[0-9]+) ]]; then
            transient_target=$((BASH_REMATCH[1]))
            if ((transient_target == scene)); then
                is_overlay=true
                candidate_score=$((candidate_score + 25000000))
                # Prefer UU's full-screen exit confirmation over small
                # statistics/control-centre surfaces.  The former must be
                # identified deterministically so its false black backing
                # surface can be clipped below.
                if [[ "$overlay_type" == *'_NET_WM_WINDOW_TYPE_DIALOG'* &&
                      "$overlay_ewmh" == *'_NET_WM_STATE_FULLSCREEN'* ]] &&
                   ((overlay_x == scene_x && overlay_y == scene_y &&
                     overlay_width == scene_width &&
                     overlay_height == scene_height)); then
                    candidate_score=$((candidate_score + 500000000))
                fi
            fi
        fi
        [[ "$is_overlay" == true ]] || continue
        if ((candidate_score > best_score)); then
            best="$candidate"
            best_score="$candidate_score"
        fi
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --class 'gameviewer.exe' 2>/dev/null || true
    )
    [[ -z "$best" ]] || printf '%s\n' "$best"
}

shape_fullscreen_dialog_overlay() {
    local scene="$1" overlay="$2" scene_x="$3" scene_y="$4"
    local scene_width="$5" scene_height="$6"
    local geometry="" overlay_x="" overlay_y=""
    local overlay_width="" overlay_height="" properties=""
    local transient_target=0

    [[ "$scene" =~ ^[1-9][0-9]*$ && "$overlay" =~ ^[1-9][0-9]*$ &&
       "$scene" != "$overlay" && "$scene_x" =~ ^-?[0-9]+$ &&
       "$scene_y" =~ ^-?[0-9]+$ && "$scene_width" =~ ^[1-9][0-9]*$ &&
       "$scene_height" =~ ^[1-9][0-9]*$ ]] || return 1
    properties="$(/usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" /usr/bin/xprop -id "$overlay" \
        WM_STATE _NET_WM_WINDOW_TYPE _NET_WM_STATE WM_TRANSIENT_FOR \
        2>/dev/null || true)"
    [[ "$properties" == *'window state: Normal'* &&
       "$properties" == *'_NET_WM_WINDOW_TYPE_DIALOG'* &&
       "$properties" == *'_NET_WM_STATE_FULLSCREEN'* &&
       "$properties" == *'WM_TRANSIENT_FOR(WINDOW)'* ]] || return 1
    if [[ "$properties" =~ window[[:space:]]id[[:space:]]\#[[:space:]](0x[0-9a-fA-F]+|[0-9]+) ]]; then
        transient_target=$((BASH_REMATCH[1]))
        ((transient_target == scene)) || return 1
    else
        return 1
    fi
    geometry="$(private_window_geometry "$overlay" || true)"
    overlay_x="$(/usr/bin/sed -n 's/^X=//p' <<<"$geometry")"
    overlay_y="$(/usr/bin/sed -n 's/^Y=//p' <<<"$geometry")"
    overlay_width="$(/usr/bin/sed -n 's/^WIDTH=//p' <<<"$geometry")"
    overlay_height="$(/usr/bin/sed -n 's/^HEIGHT=//p' <<<"$geometry")"
    [[ "$overlay_x" =~ ^-?[0-9]+$ && "$overlay_y" =~ ^-?[0-9]+$ &&
       "$overlay_width" =~ ^[1-9][0-9]*$ &&
       "$overlay_height" =~ ^[1-9][0-9]*$ ]] || return 1
    ((overlay_x == scene_x && overlay_y == scene_y &&
      overlay_width == scene_width && overlay_height == scene_height)) ||
        return 1

    # UU 4.39 renders its 448x176 confirmation card into an otherwise
    # opaque black, screen-sized DirectX dialog.  XShape removes only that
    # false backing surface.  Apply the same rectangle to the input shape so
    # invisible black pixels cannot swallow pointer events outside the card.
    /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
        /usr/bin/python3 - "$overlay" "$overlay_width" \
            "$overlay_height" <<'PY'
import ctypes
import sys


class Rectangle(ctypes.Structure):
    _fields_ = [
        ("x", ctypes.c_short),
        ("y", ctypes.c_short),
        ("width", ctypes.c_ushort),
        ("height", ctypes.c_ushort),
    ]


window, surface_width, surface_height = map(int, sys.argv[1:])
dialog_width = min(448, surface_width)
dialog_height = min(176, surface_height)
dialog_x = (surface_width - dialog_width) // 2
dialog_y = (surface_height - dialog_height) // 2

try:
    x11 = ctypes.CDLL("libX11.so.6")
    xext = ctypes.CDLL("libXext.so.6")
except OSError:
    raise SystemExit(2)

x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
xext.XShapeQueryExtension.argtypes = [
    ctypes.c_void_p,
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
]
xext.XShapeQueryExtension.restype = ctypes.c_int
xext.XShapeCombineRectangles.argtypes = [
    ctypes.c_void_p,
    ctypes.c_ulong,
    ctypes.c_int,
    ctypes.c_int,
    ctypes.c_int,
    ctypes.POINTER(Rectangle),
    ctypes.c_int,
    ctypes.c_int,
    ctypes.c_int,
]

display = x11.XOpenDisplay(None)
if not display:
    raise SystemExit(3)
event_base = ctypes.c_int()
error_base = ctypes.c_int()
if not xext.XShapeQueryExtension(
    display, ctypes.byref(event_base), ctypes.byref(error_base)
):
    x11.XCloseDisplay(display)
    raise SystemExit(4)

rectangle = Rectangle(dialog_x, dialog_y, dialog_width, dialog_height)
for shape_kind in (0, 2):  # ShapeBounding, ShapeInput
    xext.XShapeCombineRectangles(
        display,
        window,
        shape_kind,
        0,
        0,
        ctypes.byref(rectangle),
        1,
        0,  # ShapeSet
        0,  # Unsorted
    )
x11.XSync(display, 0)
x11.XCloseDisplay(display)
PY
    trace_controller_timing \
        "shaped fullscreen dialog overlay=$overlay ${overlay_width}x${overlay_height}"
}

request_presentation_mode() {
    local requested="$1"
    local temporary=""

    [[ "$requested" == windowed || "$requested" == fullscreen ]] || return 1
    temporary="$(/usr/bin/mktemp "$runtime_dir/.presentation.request.XXXXXX")"
    printf '%s\n' "$requested" >"$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$presentation_request_file"
    trace_controller_timing "presentation request $presentation_mode->$requested"
    # Disconnect the local transport only after the request is durable. This
    # x11vnc instance is loopback-only and disposable: its normal TERM path
    # can spend roughly two seconds draining a framebuffer that is already
    # obsolete. Kill only this per-viewer transport immediately so the parent
    # can re-exec against the new UU scene without showing that dead interval.
    # cleanup_window still performs the normal focus and state cleanup.
    kill -KILL "$window_vnc_pid" >/dev/null 2>&1 || true
}

monitor_private_scene() {
    local initial_capture="${5:-id:$1}"
    local selected_capture="$initial_capture"
    local selected_scale="${6:-1.000000}"
    local presentation_width="${2:-0}"
    local presentation_height="${3:-0}"
    local presentation_mode="${4:-windowed}"
    local presentation_fullscreen=false
    local candidate=""
    local desired_presentation=""
    local geometry=""
    local height=0
    local screen_height=0
    local screen_size=""
    local screen_width=0
    local source_fullscreen=false
    local viewer_window=""
    local viewer_styled=false
    local initial_viewer_focused=false
    local source_state=""
    local source_ewmh_state=""
    local management_window=""
    local previous_candidate=""
    local viewer_ewmh_state=""
    local viewer_maximized=false
    local overlay_window=""
    local shape_checked_overlay_window=""
    local capture_mode=""
    local capture_command=""
    local capture_updated=false
    local desired_capture=""
    local iconic_candidate=""
    local iconic_checks=0
    local missing_checks=0
    local fast_remote=""
    local scale=""
    local width=0
    local x=0
    local y=0
    local desired_x=0
    local desired_y=0
    local frame_extents=""
    local frame_left=0
    local frame_top=0
    local active_capture_mode="${initial_capture%%:*}"
    local active_capture_window="$1"
    local state_generation=0
    local state_signature=""
    local next_state_signature=""

    [[ "$presentation_mode" == fullscreen ]] && presentation_fullscreen=true
    management_window="$(find_management_window --known-display || true)"
    screen_size="$(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdpyinfo 2>/dev/null |
            /usr/bin/sed -n \
                's/^[[:space:]]*dimensions:[[:space:]]*\([0-9]\+x[0-9]\+\).*/\1/p' |
            /usr/bin/head -n 1
    )"
    if [[ "$screen_size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        screen_width="${BASH_REMATCH[1]}"
        screen_height="${BASH_REMATCH[2]}"
    fi
    publish_controller_state "$state_generation" starting "$1" \
        "$active_capture_mode" "$1" 0 \
        0 0 0 0 "$selected_scale" 0 false false
    while kill -0 "$window_vnc_pid" >/dev/null 2>&1; do
        if [[ "$presentation_fullscreen" == false &&
              "$controller_fullscreen" == auto &&
              -n "$management_window" ]]; then
            fast_remote="$(find_remote_scene_candidate \
                "$management_window" || true)"
            if [[ -n "$fast_remote" ]]; then
                # The 640x360 surface is UU's bootstrap canvas, not the final
                # remote resolution. Maximize it inside the private display
                # before rebuilding the local full-screen shell so the first
                # transmitted framebuffer is already the real 1920x1080
                # canvas rather than a blurry 3x enlargement.
                if maximize_private_remote_scene "$fast_remote" \
                    "$screen_width" "$screen_height"; then
                    request_presentation_mode fullscreen
                    return 0
                fi
            fi
        fi
        candidate="$(find_scene_window --known-display | /usr/bin/tail -n 1)"
        if [[ -z "$viewer_window" ]]; then
            viewer_window="$(find_local_viewer_window || true)"
        fi
        if [[ "$presentation_fullscreen" == false && -n "$viewer_window" &&
              "$controller_fullscreen" == auto &&
              "$viewer_styled" == false ]]; then
            set_local_viewer_borderless "$viewer_window" || true
            viewer_styled=true
        fi
        if [[ -n "$viewer_window" &&
              "$initial_viewer_focused" == false ]]; then
            # Both the launcher and the recreated full-screen viewer can map
            # before TigerVNC owns physical input.  In full-screen mode that
            # race lets the first wheel event reach Xfwm's workspace switcher;
            # the event then focuses TigerVNC, making only later scrolls work.
            # Activate exactly once, never steal focus back after the user
            # deliberately switches to another local application.
            if /usr/bin/xdotool windowactivate --sync "$viewer_window" \
                >/dev/null 2>&1; then
                initial_viewer_focused=true
                trace_controller_timing \
                    "viewer initially focused window=$viewer_window mode=$presentation_mode"
            fi
        fi
        # Closing UU hides it to Wine's tray. Do not leave a live black
        # viewer behind. Allow a short gap for launcher/session replacement.
        if [[ -z "$candidate" ]]; then
            missing_checks=$((missing_checks + 1))
            next_state_signature="source-missing|$viewer_window"
            if [[ "$next_state_signature" != "$state_signature" ]]; then
                state_generation=$((state_generation + 1))
                publish_controller_state "$state_generation" source-missing \
                    0 none 0 0 0 0 0 0 "$selected_scale" \
                    "$viewer_window" false false
                state_signature="$next_state_signature"
            fi
            if ((missing_checks >= 4)); then
                if [[ "$presentation_fullscreen" == true ]]; then
                    # A native TigerVNC full-screen keyboard grab deliberately
                    # blocks other physical-X clients. End the VNC side to
                    # close its shell without querying that grabbed display.
                    kill "$window_vnc_pid" >/dev/null 2>&1 || true
                elif [[ -n "$viewer_window" ]]; then
                    /usr/bin/wmctrl -ic "$(printf '0x%x' "$viewer_window")" \
                        >/dev/null 2>&1 || true
                fi
                return 0
            fi
            sleep 0.25
            continue
        fi
        missing_checks=0
        source_state="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" WM_STATE 2>/dev/null || true)"
        if [[ "$source_state" == *'window state: Iconic'* ]]; then
            # Wine briefly iconifies windows while destroying a session or
            # dismissing its dialog. Remapping in that interval cancels the
            # close and can resurrect a black/defunct session surface.
            if [[ "$candidate" != "$iconic_candidate" ]]; then
                iconic_candidate="$candidate"
                iconic_checks=0
            fi
            iconic_checks=$((iconic_checks + 1))
            next_state_signature="source-iconic|$candidate|$viewer_window"
            if [[ "$next_state_signature" != "$state_signature" ]]; then
                state_generation=$((state_generation + 1))
                publish_controller_state "$state_generation" source-iconic \
                    "$candidate" "$active_capture_mode" \
                    "$active_capture_window" 0 0 0 0 0 "$selected_scale" \
                    "$viewer_window" false false
                state_signature="$next_state_signature"
            fi
            if ((iconic_checks < 6)); then
                sleep 0.25
                continue
            fi
            # The inner minimize button operates on the private display.
            # Minimize the real desktop window, then keep its source painted
            # so either the taskbar or the app shortcut can restore it.
            if [[ "$presentation_fullscreen" == true ]]; then
                kill "$window_vnc_pid" >/dev/null 2>&1 || true
                return 0
            elif [[ -n "$viewer_window" ]]; then
                # Returning from a destroyed remote session selects the
                # previously minimized launcher. That is a window switch,
                # not a user request to minimize the outer app.
                if [[ "$candidate" == "$previous_candidate" ]]; then
                    /usr/bin/xdotool windowminimize "$viewer_window" \
                        >/dev/null 2>&1 || true
                fi
                /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
                    windowmap "$candidate" windowactivate "$candidate" \
                    >/dev/null 2>&1 || true
            fi
            sleep 0.25
            continue
        fi
        iconic_candidate=""
        iconic_checks=0
        geometry=""
        if [[ -n "$candidate" ]]; then
            geometry="$(private_window_geometry "$candidate" || true)"
        fi
        x="$(/usr/bin/sed -n 's/^X=\(-\{0,1\}[0-9]\+\)$/\1/p' \
            <<<"$geometry" | /usr/bin/head -n 1)"
        y="$(/usr/bin/sed -n 's/^Y=\(-\{0,1\}[0-9]\+\)$/\1/p' \
            <<<"$geometry" | /usr/bin/head -n 1)"
        width="$(/usr/bin/sed -n 's/^WIDTH=\([0-9]\+\)$/\1/p' \
            <<<"$geometry" | /usr/bin/head -n 1)"
        height="$(/usr/bin/sed -n 's/^HEIGHT=\([0-9]\+\)$/\1/p' \
            <<<"$geometry" | /usr/bin/head -n 1)"
        source_ewmh_state="$(/usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
            -id "$candidate" _NET_WM_STATE 2>/dev/null || true)"
        # Keep the private window inside Xvfb's root. Even direct X-window
        # capture can lose paint if a window moves partly off-screen.
        if [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ &&
              "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] &&
           ((screen_width >= width && screen_height >= height)); then
            desired_x=$((x < 0 ? 0 : x > screen_width - width ? screen_width - width : x))
            desired_y=$((y < 0 ? 0 : y > screen_height - height ? screen_height - height : y))
            if ((desired_x != x || desired_y != y)); then
                frame_extents="$(/usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
                    -id "$candidate" _NET_FRAME_EXTENTS 2>/dev/null || true)"
                frame_left=0
                frame_top=0
                if [[ "$frame_extents" =~ =\ ([0-9]+),\ ([0-9]+),\ ([0-9]+),\ ([0-9]+) ]]; then
                    frame_left="${BASH_REMATCH[1]}"
                    frame_top="${BASH_REMATCH[3]}"
                fi
                /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
                    windowmove "$candidate" "$((desired_x - frame_left))" \
                    "$((desired_y - frame_top))" \
                    >/dev/null 2>&1 || true
                x="$desired_x"
                y="$desired_y"
            fi
        fi
        source_fullscreen=false
        if [[ "$source_ewmh_state" == *'_NET_WM_STATE_FULLSCREEN'* ]]; then
            source_fullscreen=true
        elif [[ "$source_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_VERT'* &&
                "$source_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_HORZ'* &&
                "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] &&
             ((screen_width > 0 && screen_height > 0 &&
               width >= screen_width - 64 &&
               height >= screen_height - 64)); then
            # Do not mistake a 640x360 bootstrap canvas for a usable remote
            # framebuffer merely because the WM has acknowledged maximize.
            source_fullscreen=true
        fi
        # Some UU/Wine windows drop the EWMH fullscreen flag while retaining
        # the exact screen-sized video surface. Keep the local viewer full.
        if ((screen_width > 0 && screen_height > 0)) &&
           [[ "$geometry" == *$'\n'"WIDTH=$screen_width"$'\n'* &&
              "$geometry" == *$'\n'"HEIGHT=$screen_height"$'\n'* ]]; then
            source_fullscreen=true
        fi
        if [[ -z "$management_window" ]]; then
            management_window="$(find_management_window --known-display || true)"
        fi
        desired_presentation="$(presentation_mode_for_scene \
            "$candidate" "$management_window" "$width" "$height" \
            "$source_fullscreen")"
        if [[ "$desired_presentation" != "$presentation_mode" ]]; then
            # A 920x680 launcher and a full-size remote framebuffer are two
            # different presentation states. Recreate TigerVNC at the scene
            # boundary; reusing its old canvas leaves stale scale/viewport
            # state until the user manually toggles maximize twice.
            request_presentation_mode "$desired_presentation"
            return 0
        fi

        # A permanent root crop trails a draggable launcher and exposes the
        # black Xvfb background between crop updates, so windowed management
        # uses direct window capture. A full-screen remote scene is different:
        # its source remains fixed, while UU's toolbar, control centre, and
        # network statistics are separate translucent Wine windows. Capture
        # the exact root rectangle for the entire remote session so all those
        # surfaces are composed from the first frame. This avoids both -sid's
        # opaque black placeholders and mid-session framebuffer resizes.
        overlay_window="$(find_private_overlay "$candidate" "$x" "$y" \
            "$width" "$height" || true)"
        if [[ "$presentation_fullscreen" == true &&
              -n "$overlay_window" &&
              "$overlay_window" != "$shape_checked_overlay_window" ]]; then
            shape_checked_overlay_window="$overlay_window"
            if shape_fullscreen_dialog_overlay "$candidate" \
                "$overlay_window" "$x" "$y" "$width" "$height"; then
                /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/x11vnc \
                    -env "X11VNC_REMOTE=$window_remote_channel" \
                    -R refresh >/dev/null 2>&1 || true
            fi
        elif [[ -z "$overlay_window" ]]; then
            shape_checked_overlay_window=""
        fi
        capture_mode=id
        desired_capture="id:$candidate"
        if [[ "$presentation_fullscreen" == true ]]; then
            capture_mode=root-clip
            desired_capture="root-clip:$candidate:${width}x${height}+${x}+${y}"
        elif [[ -n "$overlay_window" ]]; then
            capture_mode=sid
            desired_capture="sid:$candidate"
        fi
        if [[ "$desired_capture" != "$selected_capture" ]]; then
            capture_updated=false
            if [[ "$capture_mode" == root-clip ]]; then
                if [[ "$active_capture_mode" == root-clip ]]; then
                    capture_command="script:clip:${width}x${height}+${x}+${y};refresh"
                else
                    capture_command="script:id:root;clip:${width}x${height}+${x}+${y};refresh"
                fi
                if /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/x11vnc \
                        -env "X11VNC_REMOTE=$window_remote_channel" \
                        -R "$capture_command" >/dev/null 2>&1; then
                    capture_updated=true
                fi
            elif [[ "$capture_mode" == sid ]]; then
                capture_command="script:sid:$candidate;refresh"
                if /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/x11vnc \
                        -env "X11VNC_REMOTE=$window_remote_channel" \
                        -R "$capture_command" >/dev/null 2>&1; then
                    capture_updated=true
                fi
            else
                # A plain id command clears shifted-root mode reliably. The
                # old x11vnc script parser can leave -sid selected when id and
                # refresh are bundled in one script, so refresh separately.
                capture_command="id:$candidate"
                if /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/x11vnc \
                        -env "X11VNC_REMOTE=$window_remote_channel" \
                        -R "$capture_command" >/dev/null 2>&1 &&
                   /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" \
                    /usr/bin/x11vnc \
                        -env "X11VNC_REMOTE=$window_remote_channel" \
                        -R refresh >/dev/null 2>&1; then
                    capture_updated=true
                fi
            fi
            if [[ "$capture_updated" == true ]]; then
                selected_capture="$desired_capture"
                active_capture_mode="$capture_mode"
                active_capture_window="$candidate"
                if [[ -n "$overlay_window" ]]; then
                    /usr/bin/env DISPLAY="$bridge_display" \
                        XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
                        windowraise "$overlay_window" >/dev/null 2>&1 || true
                fi
            fi
        fi
        viewer_maximized=false
        if [[ "$presentation_fullscreen" == true ]]; then
            viewer_maximized=true
        elif [[ -n "$viewer_window" ]]; then
            viewer_ewmh_state="$(/usr/bin/xprop -id "$viewer_window" \
                _NET_WM_STATE 2>/dev/null || true)"
            if [[ "$viewer_ewmh_state" == *'_NET_WM_STATE_FULLSCREEN'* ||
                  ( "$viewer_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_VERT'* &&
                    "$viewer_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_HORZ'* ) ]]; then
                viewer_maximized=true
            fi
        fi
        # TigerVNC is the presentation shell, not a second application
        # window. It owns one real full-screen surface so Xfwm does not steal
        # Alt+Tab and no duplicate Linux titlebar is visible. UU's inner
        # controls remain the sole minimize/maximize/close controls.
        previous_candidate="$candidate"
        # Fit the full source into the actual viewport, including when the
        # user resizes/maximizes the outer window. UU's launcher has a fixed
        # layout, so changing its X window dimensions cannot implement this.
        if [[ "$presentation_fullscreen" == true &&
              "$presentation_width" =~ ^[1-9][0-9]*$ &&
              "$presentation_height" =~ ^[1-9][0-9]*$ ]]; then
            scale="$(fit_scale "$width" "$height" \
                "$presentation_width" "$presentation_height" || true)"
        else
            scale="$(viewer_fit_scale "$width" "$height" "$viewer_window" || true)"
        fi
        if [[ -n "$scale" && "$scale" != "$selected_scale" ]]; then
            if /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" /usr/bin/x11vnc \
                -env "X11VNC_REMOTE=$window_remote_channel" \
                -R "scale:$scale" >/dev/null 2>&1; then
                selected_scale="$scale"
            fi
        fi
        next_state_signature="ready|$candidate|$active_capture_mode|$active_capture_window|$overlay_window|$x|$y|$width|$height|$selected_scale|$viewer_window|$source_fullscreen|$viewer_maximized"
        if [[ "$next_state_signature" != "$state_signature" ]]; then
            state_generation=$((state_generation + 1))
            publish_controller_state "$state_generation" ready "$candidate" \
                "$active_capture_mode" "$active_capture_window" \
                "$overlay_window" "$x" "$y" "$width" "$height" \
                "$selected_scale" "$viewer_window" "$source_fullscreen" \
                "$viewer_maximized"
            state_signature="$next_state_signature"
        fi
        # Keep drag tracking responsive; the costlier focus/clip/scale
        # commands above still run only when their state changes.
        sleep 0.10
    done
}

restore_private_focus() {
    local client_window=""
    local relay_window=""

    if [[ -e "$bridge_focus_file" ]]; then
        client_window="$(find_client_window | /usr/bin/tail -n 1)"
        if [[ -n "$client_window" ]]; then
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool windowactivate "$client_window" \
                    >/dev/null 2>&1 || true
            return 0
        fi
    fi
    relay_window="$(find_relay_window)"
    if [[ -n "$relay_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowactivate "$relay_window" \
                >/dev/null 2>&1 || true
    fi
}

cleanup_relay_vnc() {
    trap - EXIT INT TERM HUP
    if [[ -n "$relay_focus_pid" ]]; then
        kill "$relay_focus_pid" >/dev/null 2>&1 || true
        wait "$relay_focus_pid" 2>/dev/null || true
    fi
    if [[ -n "$vnc_pid" ]]; then
        kill "$vnc_pid" >/dev/null 2>&1 || true
        wait "$vnc_pid" 2>/dev/null || true
    fi
    restore_private_focus || true
}

prepare_relay_vnc_auth() {
    local password=""
    local quoted_temporary=""
    local temporary=""
    local vnc_password=""

    if [[ -s "$relay_vnc_auth_file" ]]; then
        chmod 0600 "$relay_vnc_auth_file"
        return 0
    fi
    if [[ ! -x /usr/bin/secret-tool ]]; then
        printf 'The relay VNC credential is missing and secret-tool is unavailable.\n' \
            >&2
        return 1
    fi
    password="$(
        /usr/bin/secret-tool lookup service uu-desktop-bridge \
            username "$USER" 2>/dev/null || true
    )"
    if [[ -z "$password" ]]; then
        printf 'The relay VNC credential could not be recovered from the keyring.\n' \
            >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$config_dir"
    temporary="$(/usr/bin/mktemp "$config_dir/relay-vnc.pass.XXXXXX")"
    # Classic VNC authentication consumes at most eight password bytes.
    # Truncate explicitly so x11vnc does not reject a longer RDP credential
    # and desynchronize its interactive confirmation prompts.
    vnc_password="$(LC_ALL=C printf '%.8s' "$password")"
    printf -v quoted_temporary '%q' "$temporary"
    if ! printf '%s\n%s\ny\n' "$vnc_password" "$vnc_password" |
        /usr/bin/script -qefc \
            "/usr/bin/x11vnc -storepasswd $quoted_temporary" /dev/null \
            >/dev/null 2>&1; then
        rm -f "$temporary"
        unset password vnc_password
        printf 'The relay VNC credential could not be generated.\n' >&2
        return 1
    fi
    unset password vnc_password
    chmod 0600 "$temporary"
    mv -f "$temporary" "$relay_vnc_auth_file"
}

find_local_viewer_window() {
    local window=""

    [[ -n "${DISPLAY:-}" ]] || return 1
    while read -r candidate; do
        if [[ "$(
            /usr/bin/xdotool getwindowname "$candidate" 2>/dev/null || true
        )" == 'UU Remote - TigerVNC' ]]; then
            window="$candidate"
        fi
    done < <(
        /usr/bin/xdotool search --class 'TigerVNC Viewer' 2>/dev/null || true
    )
    [[ -n "$window" ]] || return 1
    printf '%s\n' "$window"
}

focus_local_viewer_when_mapped() {
    local mode="$1"
    local active=""
    local viewer=""

    # TigerVNC is started in the foreground below, so prepare the focus handoff
    # first.  Polling every 20 ms closes the short map-to-focus gap in which an
    # initial wheel event can otherwise reach Xfwm's workspace bindings.
    for _ in {1..200}; do
        viewer="$(find_local_viewer_window || true)"
        if [[ -n "$viewer" ]]; then
            /usr/bin/xdotool windowactivate "$viewer" >/dev/null 2>&1 ||
                return 1
            for _ in {1..20}; do
                active="$(/usr/bin/xdotool getactivewindow 2>/dev/null || true)"
                if [[ "$active" == "$viewer" ]]; then
                    trace_controller_timing \
                        "viewer map focus complete window=$viewer mode=$mode"
                    return 0
                fi
                sleep 0.01
            done
            return 1
        fi
        sleep 0.02
    done
    return 1
}

set_local_viewer_borderless() {
    local window="$1"

    [[ "$window" =~ ^[1-9][0-9]*$ ]] || return 1
    # In automatic mode the windowed shell represents UU's launcher, not a
    # second application. Let UU's own minimize/maximize/close row be the
    # only visible chrome instead of stacking an Xfwm titlebar above it.
    # xprop writes this uncommon property with type CARDINAL, which Xfwm
    # ignores. Set its required self-named X atom type through Xlib instead.
    /usr/bin/python3 - "$window" <<'PY'
import ctypes
import sys

x11 = ctypes.CDLL("libX11.so.6")
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XChangeProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong,
    ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_ubyte), ctypes.c_int,
]
x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
display = x11.XOpenDisplay(None)
if not display:
    raise SystemExit(2)
atom = x11.XInternAtom(display, b"_MOTIF_WM_HINTS", 0)
values = (ctypes.c_ulong * 5)(2, 0, 0, 0, 0)
status = x11.XChangeProperty(
    display, int(sys.argv[1]), atom, atom, 32, 0,
    ctypes.cast(values, ctypes.POINTER(ctypes.c_ubyte)), 5,
)
x11.XSync(display, 0)
x11.XCloseDisplay(display)
raise SystemExit(0 if status == 1 else 3)
PY
}

viewer_fit_scale() {
    local source_width="$1" source_height="$2"
    local window="${3:-}" geometry="" viewport_width="" viewport_height=""
    [[ "$source_width" =~ ^[1-9][0-9]*$ &&
       "$source_height" =~ ^[1-9][0-9]*$ ]] || return 1
    if [[ -z "$window" ]]; then
        window="$(find_local_viewer_window)" || return 1
    fi
    geometry="$(/usr/bin/xdotool getwindowgeometry --shell "$window" \
        2>/dev/null)" || return 1
    viewport_width="$(sed -n 's/^WIDTH=//p' <<<"$geometry")"
    viewport_height="$(sed -n 's/^HEIGHT=//p' <<<"$geometry")"
    [[ "$viewport_width" =~ ^[1-9][0-9]*$ &&
       "$viewport_height" =~ ^[1-9][0-9]*$ ]] || return 1
    fit_scale "$source_width" "$source_height" \
        "$viewport_width" "$viewport_height"
}

fit_scale() {
    local source_width="$1" source_height="$2"
    local viewport_width="$3" viewport_height="$4"
    [[ "$source_width" =~ ^[1-9][0-9]*$ &&
       "$source_height" =~ ^[1-9][0-9]*$ &&
       "$viewport_width" =~ ^[1-9][0-9]*$ &&
       "$viewport_height" =~ ^[1-9][0-9]*$ ]] || return 1
    # x11vnc rounds scaled width up to a multiple of four. Reserve those
    # pixels to avoid a scrollbar which itself reduces the viewport.
    /usr/bin/awk -v sw="$source_width" -v sh="$source_height" \
        -v vw="$viewport_width" -v vh="$viewport_height" 'BEGIN {
            vw = int(vw / 4) * 4;
            s = vw / sw; if (vh / sh < s) s = vh / sh;
            printf "%.6f\n", int(s * 1000000) / 1000000;
        }'
}

wake_private_client() {
    # fd 9 owns the outer-window flock.  UU's Wine processes are long-lived,
    # so letting the activation helper inherit it makes a closed viewer leave
    # the lock held by wineserver forever.  Close the descriptor at this
    # process boundary; the coordinating shell remains the sole lock owner.
    /usr/bin/timeout 8 "$HOME/.local/bin/uu-remote" wake-private 9>&- \
        >>"$state_dir/client-wake.log" 2>&1
}

restore_private_client_window() {
    local client_window=""

    # The controls painted inside the VNC canvas belong to UU's private
    # Wine desktop. If UU is minimized there, restoring only TigerVNC leaves
    # an empty canvas with no private taskbar from which to recover it.
    # Discover in this shell, not only inside the command substitution below,
    # so the DISPLAY and XAUTHORITY values remain available to xdotool.
    discover_controller || return 1
    client_window="$(find_scene_window | /usr/bin/tail -n 1)"
    if [[ -z "$client_window" ]]; then
        wake_private_client || return 1
        for _ in {1..40}; do
            client_window="$(find_scene_window | /usr/bin/tail -n 1)"
            [[ -n "$client_window" ]] && break
            sleep 0.1
        done
    fi
    [[ -n "$client_window" ]] || return 1
    /usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" \
        /usr/bin/xdotool windowmap "$client_window" \
            windowactivate --sync "$client_window" >/dev/null 2>&1
}

activate_existing_window() {
    local window=""

    window="$(find_local_viewer_window)" || return 1
    # Restore both layers. The inner UU minimize button iconifies the source
    # window and TigerVNC can be iconified at the same time. Reopening the
    # desktop entry must therefore deiconify the private source first.
    restore_private_client_window || true
    /usr/bin/xdotool windowmap "$window" \
        windowactivate --sync "$window" >/dev/null 2>&1
}

choose_window_port() {
    local candidate=$((vnc_port + 1))

    for _ in {1..64}; do
        if ((candidate > 65535)); then
            candidate=5900
        fi
        if [[ "$candidate" != "$web_port" ]] &&
           ! listener_present "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
        candidate=$((candidate + 1))
    done
    return 1
}

ensure_bridge() {
    local bridge_process=false

    if discover_bridge; then
        return 0
    fi
    if /usr/bin/pgrep -u "$UID" -f \
        '(^|/)uu-remote-bridge($|[[:space:]])' >/dev/null; then
        bridge_process=true
    fi
    if [[ "$bridge_process" == false ]]; then
        "${systemctl_user[@]}" start uu-remote-bridge.service || return 1
    fi
    wait_for_bridge
}

serve_relay_vnc() {
    local connected=false
    local connected_checks=0
    local idle_checks=0
    local relay_window=""
    local ready=false

    for command in /usr/bin/script /usr/bin/ss /usr/bin/x11vnc \
        /usr/bin/xdotool /usr/bin/xdpyinfo; do
        if [[ ! -x "$command" ]]; then
            printf 'UU relay VNC dependency is missing: %s\n' "$command" >&2
            return 1
        fi
    done
    if ! ensure_bridge; then
        printf 'The Ubuntu desktop bridge could not start.\n' >&2
        return 1
    fi
    if ! prepare_relay_vnc_auth; then
        return 1
    fi
    if listener_present "$relay_vnc_port"; then
        printf 'UU relay VNC port %s is already in use.\n' \
            "$relay_vnc_port" >&2
        return 1
    fi
    relay_window="$(find_relay_window)"
    if [[ -z "$relay_window" ]]; then
        printf 'The Ubuntu desktop relay window is unavailable.\n' >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$state_dir"
    trap cleanup_relay_vnc EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        -id "$relay_window" \
        -rfbport "$relay_vnc_port" \
        -listen 127.0.0.1 \
        -localhost \
        -no6 \
        -rfbauth "$relay_vnc_auth_file" \
        -forever \
        -shared \
        -noxdamage \
        -nowf \
        -noscr \
        -repeat \
        -nobell \
        -modtweak \
        -xkb \
        -add_keysyms \
        -wait 10 \
        -defer 0 \
        -nowait_bog \
        -sb 0 \
        -desktop 'OptiPlex-7090 Physical Desktop' \
        -quiet \
        >>"$state_dir/relay-x11vnc.log" 2>&1 &
    vnc_pid=$!

    for _ in {1..80}; do
        if listener_present "$relay_vnc_port" &&
           kill -0 "$vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'The Ubuntu desktop relay VNC listener did not start.\n' >&2
        return 1
    fi

    for _ in {1..300}; do
        if /usr/bin/ss -H -tn state established \
            "sport = :$relay_vnc_port" 2>/dev/null |
            /usr/bin/grep -q .; then
            connected_checks=$((connected_checks + 1))
            if ((connected_checks >= 3)); then
                connected=true
                break
            fi
        else
            connected_checks=0
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.2
    done
    if [[ "$connected" != true ]]; then
        printf 'No relay VNC viewer connected within 60 seconds.\n' >&2
        return 1
    fi

    (
        while kill -0 "$vnc_pid" >/dev/null 2>&1; do
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool windowactivate "$relay_window" \
                    >/dev/null 2>&1 || true
            sleep 0.25
        done
    ) &
    relay_focus_pid=$!

    while kill -0 "$vnc_pid" >/dev/null 2>&1; do
        if /usr/bin/ss -H -tn state established \
            "sport = :$relay_vnc_port" 2>/dev/null |
            /usr/bin/grep -q .; then
            idle_checks=0
        else
            idle_checks=$((idle_checks + 1))
            if ((idle_checks >= 25)); then
                break
            fi
        fi
        sleep 0.2
    done
}

open_window() {
    local client_window=""
    local client_geometry=""
    local client_ewmh_state=""
    local client_height=680
    local client_source_fullscreen=false
    local client_source_toplevel=false
    local client_width=920
    local client_x=0
    local client_y=0
    local command
    local frame_extents=""
    local frame_left=0
    local frame_top=0
    local initial_capture_signature=""
    local initial_scale="1.000000"
    local management_window=""
    local maximized_geometry=""
    local presentation_mode=windowed
    local private_screen=""
    local private_screen_width=0
    local private_screen_height=0
    local presentation_width=0
    local presentation_height=0
    local ready=false
    local requested_presentation=""
    local viewer_status=0
    local window_port=""
    local -a x11vnc_capture_args=()

    trace_controller_timing 'open begin'

    if [[ -z "${DISPLAY:-}" ]]; then
        notify_error 'Open UU Remote from a logged-in graphical desktop.'
        return 1
    fi
    for command in /usr/bin/flock /usr/bin/ss /usr/bin/vncviewer \
        /usr/bin/x11vnc /usr/bin/xdotool /usr/bin/xdpyinfo /usr/bin/wmctrl \
        /usr/bin/xprop /usr/bin/xwininfo /usr/bin/python3; do
        if [[ ! -x "$command" ]]; then
            notify_error "UU window dependency is missing: $command"
            return 1
        fi
    done

    /usr/bin/install -d -m 0700 "$runtime_dir" "$state_dir"
    exec 9>"$window_lock_file"
    if ! /usr/bin/flock -n 9; then
        if activate_existing_window; then
            return 0
        fi
        if ! /usr/bin/flock -w 4 9; then
            if activate_existing_window; then
                return 0
            fi
            notify_error 'The UU Remote window is still closing; try again.'
            return 1
        fi
    fi
    trace_controller_timing 'window lock acquired'
    rm -f "$presentation_request_file"
    if ! ensure_bridge; then
        notify_error 'The Ubuntu desktop bridge could not start.'
        return 1
    fi
    discover_controller || return 1

    if [[ -z "$(find_scene_window)" ]]; then
        wake_private_client || true
    fi
    for _ in {1..120}; do
        client_window="$(find_scene_window | /usr/bin/tail -n 1)"
        [[ -n "$client_window" ]] && break
        sleep 0.1
    done
    if [[ -z "$client_window" ]]; then
        notify_error 'The UU management window did not become ready.'
        return 1
    fi
    trace_controller_timing "scene selected window=$client_window"
    client_geometry="$(private_window_geometry "$client_window" || true)"
    if [[ "$client_geometry" == *$'\nWIDTH='* &&
          "$client_geometry" == *$'\nHEIGHT='* ]]; then
        client_width="$(
            /usr/bin/sed -n 's/^WIDTH=\([0-9]\+\)$/\1/p' \
                <<<"$client_geometry" | /usr/bin/head -n 1
        )"
        client_height="$(
            /usr/bin/sed -n 's/^HEIGHT=\([0-9]\+\)$/\1/p' \
                <<<"$client_geometry" | /usr/bin/head -n 1
        )"
        client_x="$(
            /usr/bin/sed -n 's/^X=\(-\{0,1\}[0-9]\+\)$/\1/p' \
                <<<"$client_geometry" | /usr/bin/head -n 1
        )"
        client_y="$(
            /usr/bin/sed -n 's/^Y=\(-\{0,1\}[0-9]\+\)$/\1/p' \
                <<<"$client_geometry" | /usr/bin/head -n 1
        )"
    fi
    if [[ ! "$client_width" =~ ^[0-9]+$ ||
          ! "$client_height" =~ ^[0-9]+$ ||
          "$client_width" -lt 400 || "$client_height" -lt 300 ]]; then
        client_width=920
        client_height=680
    fi
    [[ "$client_x" =~ ^-?[0-9]+$ ]] || client_x=0
    [[ "$client_y" =~ ^-?[0-9]+$ ]] || client_y=0
    # Recover a launcher left off-screen by an earlier broken drag before
    # the first VNC framebuffer is created; otherwise the viewer can open
    # already collapsed to a black thumbnail.
    private_screen="$(/usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" /usr/bin/xdpyinfo 2>/dev/null | \
        /usr/bin/sed -n \
        's/^[[:space:]]*dimensions:[[:space:]]*\([0-9]\+x[0-9]\+\).*/\1/p' | \
        /usr/bin/head -n 1)"
    if [[ "$private_screen" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        private_screen_width="${BASH_REMATCH[1]}"
        private_screen_height="${BASH_REMATCH[2]}"
        if ((client_width <= private_screen_width &&
             client_height <= private_screen_height)); then
            local bounded_x=$((client_x < 0 ? 0 :
                client_x > private_screen_width - client_width ?
                private_screen_width - client_width : client_x))
            local bounded_y=$((client_y < 0 ? 0 :
                client_y > private_screen_height - client_height ?
                private_screen_height - client_height : client_y))
            if ((bounded_x != client_x || bounded_y != client_y)); then
                frame_extents="$(/usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
                    -id "$client_window" _NET_FRAME_EXTENTS 2>/dev/null || true)"
                if [[ "$frame_extents" =~ =\ ([0-9]+),\ ([0-9]+),\ ([0-9]+),\ ([0-9]+) ]]; then
                    frame_left="${BASH_REMATCH[1]}"
                    frame_top="${BASH_REMATCH[3]}"
                fi
                if /usr/bin/env DISPLAY="$bridge_display" \
                    XAUTHORITY="$bridge_xauthority" /usr/bin/xdotool \
                    windowmove "$client_window" \
                    "$((bounded_x - frame_left))" \
                    "$((bounded_y - frame_top))" \
                    >/dev/null 2>&1; then
                    client_x="$bounded_x"
                    client_y="$bounded_y"
                fi
            fi
        fi
    fi
    client_ewmh_state="$(/usr/bin/env DISPLAY="$bridge_display" \
        XAUTHORITY="$bridge_xauthority" /usr/bin/xprop \
        -id "$client_window" _NET_WM_STATE _NET_WM_WINDOW_TYPE \
        WM_TRANSIENT_FOR 2>/dev/null || true)"
    if [[ "$client_ewmh_state" == *'_NET_WM_WINDOW_TYPE_NORMAL'* &&
          "$client_ewmh_state" != *'WM_TRANSIENT_FOR(WINDOW)'* ]]; then
        client_source_toplevel=true
    fi
    if [[ "$client_ewmh_state" == *'_NET_WM_STATE_FULLSCREEN'* ]] ||
       { [[ "$client_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_VERT'* &&
            "$client_ewmh_state" == *'_NET_WM_STATE_MAXIMIZED_HORZ'* ]] &&
         ((private_screen_width > 0 && private_screen_height > 0 &&
           client_width >= private_screen_width - 64 &&
           client_height >= private_screen_height - 64)); } ||
       ((private_screen_width > 0 && private_screen_height > 0 &&
         client_width == private_screen_width &&
         client_height == private_screen_height)); then
        client_source_fullscreen=true
    fi
    management_window="$(find_management_window --known-display || true)"
    if [[ "$controller_fullscreen" != off &&
          -n "$management_window" && "$client_window" != "$management_window" &&
          "$client_source_toplevel" == true ]]; then
        if maximize_private_remote_scene "$client_window" \
            "$private_screen_width" "$private_screen_height"; then
            maximized_geometry="$(private_window_geometry "$client_window" || true)"
            client_x="$(/usr/bin/sed -n 's/^X=//p' <<<"$maximized_geometry")"
            client_y="$(/usr/bin/sed -n 's/^Y=//p' <<<"$maximized_geometry")"
            client_width="$(/usr/bin/sed -n 's/^WIDTH=//p' \
                <<<"$maximized_geometry")"
            client_height="$(/usr/bin/sed -n 's/^HEIGHT=//p' \
                <<<"$maximized_geometry")"
            client_source_fullscreen=true
        fi
    fi
    presentation_mode="$(presentation_mode_for_scene \
        "$client_window" "$management_window" "$client_width" \
        "$client_height" "$client_source_fullscreen")"
    if [[ "$presentation_mode" == fullscreen ]]; then
        controller_fullscreen_value=1
        initial_capture_signature="root-clip:$client_window:${client_width}x${client_height}+${client_x}+${client_y}"
        x11vnc_capture_args=(
            -clip "${client_width}x${client_height}+${client_x}+${client_y}"
        )
    else
        controller_fullscreen_value=0
        initial_capture_signature="id:$client_window"
        x11vnc_capture_args=(-id "$client_window")
    fi
    window_port="$(choose_window_port)" || {
        notify_error 'No free loopback port is available for the UU window.'
        return 1
    }
    window_remote_channel="UURB_WINDOW_${UID}_${window_port}_$$"
    printf '%s\n' "$window_port" >"$runtime_dir/window.port"
    chmod 0600 "$runtime_dir/window.port"
    trap cleanup_window EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    focus_client

    # Query the physical viewport before TigerVNC performs its intentional
    # full-screen keyboard grab. The monitor can then stay entirely off the
    # grabbed physical X connection while UU is being controlled.
    if read -r presentation_width presentation_height < <(
        /usr/bin/xdotool getdisplaygeometry 2>/dev/null || true
    ); then
        [[ "$presentation_width" =~ ^[1-9][0-9]*$ ]] || presentation_width=0
        [[ "$presentation_height" =~ ^[1-9][0-9]*$ ]] || presentation_height=0
    fi
    if [[ "$presentation_mode" == fullscreen &&
          "$presentation_width" =~ ^[1-9][0-9]*$ &&
          "$presentation_height" =~ ^[1-9][0-9]*$ ]]; then
        initial_scale="$(fit_scale "$client_width" "$client_height" \
            "$presentation_width" "$presentation_height" || true)"
        [[ "$initial_scale" =~ ^[0-9]+([.][0-9]+)?$ ]] ||
            initial_scale=1.000000
        if [[ "$initial_scale" != 1 && "$initial_scale" != 1.0 &&
              "$initial_scale" != 1.000000 ]]; then
            x11vnc_capture_args+=(-scale "$initial_scale")
        fi
    fi

    # A draggable management window uses direct X-window capture. A stable
    # full-screen remote session starts with an exact root clip so UU's
    # separate translucent toolbar/control windows are composited from the
    # first framebuffer instead of arriving as opaque black rectangles.
    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        "${x11vnc_capture_args[@]}" \
        -input KMBC \
        -always_inject \
        -xwarppointer \
        -nocursorpos \
        -env "X11VNC_REMOTE=$window_remote_channel" \
        -rfbport "$window_port" \
        -listen 127.0.0.1 \
        -localhost \
        -no6 \
        -nopw \
        -forever \
        -shared \
        -noxdamage \
        -nowf \
        -noscr \
        -repeat \
        -nobell \
        -modtweak \
        -xkb \
        -add_keysyms \
        -wait 10 \
        -defer 0 \
        -nowait_bog \
        -sb 0 \
        -desktop 'UU Remote' \
        -gone "$script_path release-client" \
        -quiet \
        >>"$state_dir/window-x11vnc.log" 2>&1 9>&- &
    window_vnc_pid=$!
    trace_controller_timing "x11vnc spawned pid=$window_vnc_pid mode=$presentation_mode"

    for _ in {1..80}; do
        if listener_present "$window_port" &&
           kill -0 "$window_vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$window_vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        notify_error 'The UU management window could not be exposed locally.'
        return 1
    fi
    trace_controller_timing 'x11vnc listener ready'

    focus_local_viewer_when_mapped "$presentation_mode" 9>&- &
    window_focus_pid=$!
    trace_controller_timing "focus guard spawned pid=$window_focus_pid"

    monitor_private_scene "$client_window" \
        "$presentation_width" "$presentation_height" \
        "$presentation_mode" "$initial_capture_signature" \
        "$initial_scale" 9>&- &
    window_monitor_pid=$!
    trace_controller_timing "monitor spawned pid=$window_monitor_pid"

    set +e
    trace_controller_timing "viewer start mode=$presentation_mode"
    /usr/bin/vncviewer \
        -geometry "${client_width}x${client_height}" \
        -FullScreen="$controller_fullscreen_value" \
        -FullScreenMode=Current \
        -FullscreenSystemKeys=1 \
        -MenuKey=F8 \
        -ViewOnly=0 \
        -AlwaysCursor=1 \
        -CursorType=System \
        -PointerEventInterval=8 \
        -AutoSelect=0 \
        -FullColor=1 \
        -PreferredEncoding=Raw \
        -Shared=1 \
        -RemoteResize=0 \
        -ReconnectOnError=0 \
        -AlertOnFatalError=0 \
        -SecurityTypes=None \
        "127.0.0.1::$window_port" \
        >>"$state_dir/window-viewer.log" 2>&1 9>&-
    viewer_status=$?
    trace_controller_timing "viewer exit status=$viewer_status"
    set -e
    if [[ -r "$presentation_request_file" ]]; then
        read -r requested_presentation <"$presentation_request_file" ||
            requested_presentation=""
    fi
    if [[ -z "$requested_presentation" &&
          "$controller_fullscreen" == auto &&
          "$presentation_mode" == fullscreen ]]; then
        # UU destroys the remote canvas before it re-activates the launcher.
        # Since x11vnc is attached to that exact canvas with -id, it can exit
        # before the monitor gets one last iteration in which to request the
        # fullscreen -> windowed transition. Wait briefly for the launcher
        # here in the owning process and make the transition deterministic.
        # If the VNC server is still alive and UU still exposes a normal
        # remote scene, this was an intentional F8 disconnect; the fail-closed
        # recovery below ends that hidden session instead of waiting.
        for _ in {1..20}; do
            if controller_management_scene_active; then
                requested_presentation=windowed
                break
            fi
            if kill -0 "$window_vnc_pid" >/dev/null 2>&1 &&
               controller_remote_session_active; then
                break
            fi
            sleep 0.25
        done
    fi
    if [[ "$requested_presentation" == windowed ||
          "$requested_presentation" == fullscreen ]]; then
        printf 'Switching UU controller presentation: %s -> %s\n' \
            "$presentation_mode" "$requested_presentation" \
            >>"$state_dir/window-viewer.log"
        cleanup_window
        exec 9>&-
        trace_controller_timing "reexec mode=$requested_presentation"
        exec "$script_path" window
    fi
    if [[ "$presentation_mode" == fullscreen ]] &&
       { [[ "$controller_fullscreen" == auto ]] ||
         controller_remote_session_active; }; then
        # Disconnecting TigerVNC must never leave an invisible UU session
        # controlling the peer. UU's confirmation surface is rendered inside
        # the private Wine desktop, and a destroyed remote canvas can race the
        # launcher by a few seconds. Fail closed in automatic mode as well:
        # restart only this user bridge, then reopen on UU's device list with
        # the account state preserved. Thus F8 is never a required second
        # disconnect step and can never strand a still-controlled peer.
        printf '%s\n' \
            'The controller viewer closed during an active remote session; restarting UU to disconnect the peer.' \
            >>"$state_dir/window-viewer.log"
        cleanup_window
        exec 9>&-
        if ! "${systemctl_user[@]}" restart uu-remote-bridge.service; then
            notify_error 'UU Remote could not safely end the hidden remote session.'
            return 1
        fi
        exec "$script_path" window
    fi
    return "$viewer_status"
}

serve_console() {
    local command
    local ready=false

    for command in /usr/bin/curl /usr/bin/ss /usr/bin/websockify \
        /usr/bin/x11vnc /usr/bin/xdotool /usr/bin/xdpyinfo; do
        if [[ ! -x "$command" ]]; then
            printf 'UU console dependency is missing: %s\n' "$command" >&2
            return 1
        fi
    done
    if [[ ! -f "$novnc_root/vnc.html" ]]; then
        printf 'noVNC web assets are missing from %s.\n' "$novnc_root" >&2
        return 1
    fi
    if ! wait_for_bridge; then
        printf 'The UU private X display did not become ready.\n' >&2
        return 1
    fi
    discover_controller || return 1
    if listener_present "$vnc_port" || listener_present "$web_port"; then
        printf 'UU console port %s or %s is already in use.\n' \
            "$vnc_port" "$web_port" >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$runtime_dir" "$state_dir"
    printf '%s\n' "$bridge_display" >"$runtime_dir/display"
    printf '%s\n' "$console_url" >"$runtime_dir/url"
    chmod 0600 "$runtime_dir/display" "$runtime_dir/url"
    trap cleanup_server EXIT INT TERM HUP

    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        -rfbport "$vnc_port" \
        -xwarppointer \
        -nocursorpos \
        -localhost \
        -no6 \
        -nopw \
        -forever \
        -shared \
        -quiet \
        -afteraccept "$script_path focus-client" \
        -gone "$script_path release-client" \
        >>"$state_dir/x11vnc.log" 2>&1 &
    vnc_pid=$!

    for _ in {1..80}; do
        if listener_present "$vnc_port" &&
           kill -0 "$vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'x11vnc did not expose the UU private display.\n' >&2
        return 1
    fi

    /usr/bin/websockify --web="$novnc_root" \
        "127.0.0.1:$web_port" "127.0.0.1:$vnc_port" \
        >>"$state_dir/websockify.log" 2>&1 &
    websockify_pid=$!
    ready=false
    for _ in {1..80}; do
        if /usr/bin/curl --fail --silent --show-error \
            "http://127.0.0.1:$web_port/vnc.html" >/dev/null 2>&1 &&
           kill -0 "$websockify_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$websockify_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'The UU noVNC endpoint did not become ready.\n' >&2
        return 1
    fi

    printf 'UU Remote console: %s (display %s)\n' \
        "$console_url" "$bridge_display"
    set +e
    wait -n "$vnc_pid" "$websockify_pid"
    set -e
    return 1
}

launch_browser() {
    local profile="$HOME/.local/share/uu-remote-console/chrome-profile"

    /usr/bin/install -d -m 0700 "$profile"
    if [[ -x /usr/bin/google-chrome ]]; then
        exec /usr/bin/google-chrome \
            --app="$console_url" \
            --class=uu-remote-console \
            --user-data-dir="$profile" \
            --no-first-run \
            --no-default-browser-check \
            --disable-sync
    elif [[ -x /snap/bin/chromium ]]; then
        exec /snap/bin/chromium \
            --app="$console_url" \
            --class=uu-remote-console \
            --user-data-dir="$profile" \
            --no-first-run \
            --no-default-browser-check \
            --disable-sync
    fi
    exec /usr/bin/xdg-open "$console_url"
}

open_console() {
    local ready=false

    ensure_bridge || {
        notify_error 'The Ubuntu desktop bridge could not start.'
        return 1
    }

    "${systemctl_user[@]}" reset-failed uu-remote-console.service \
        >/dev/null 2>&1 || true
    if ! "${systemctl_user[@]}" start uu-remote-console.service; then
        notify_error 'The local UU Remote console could not start.'
        return 1
    fi
    for _ in {1..160}; do
        if /usr/bin/curl --fail --silent \
            "http://127.0.0.1:$web_port/vnc.html" >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        notify_error 'The local UU Remote console did not become ready.'
        return 1
    fi
    launch_browser
}

case "${1:-open}" in
    window)
        open_window
        ;;
    open)
        open_console
        ;;
    serve)
        serve_console
        ;;
    relay)
        serve_relay_vnc
        ;;
    relay-port)
        printf '%s\n' "$relay_vnc_port"
        ;;
    status)
        printf 'URL: %s\n' "$console_url"
        printf 'Service: %s\n' \
            "$("${systemctl_user[@]}" is-active uu-remote-console.service \
                2>/dev/null || true)"
        if discover_bridge; then
            printf 'Bridge display: %s\n' "$bridge_display"
        else
            printf 'Bridge display: unavailable\n'
        fi
        ;;
    stop)
        exec "${systemctl_user[@]}" stop uu-remote-console.service
        ;;
    url)
        printf '%s\n' "$console_url"
        ;;
    focus-client)
        focus_client
        ;;
    release-client)
        release_client
        ;;
    *)
        printf 'usage: uu-remote-console [window|open|serve|relay|relay-port|status|stop|url|focus-client|release-client]\n' \
            >&2
        exit 2
        ;;
esac
