#!/usr/bin/env bash

set -Eeuo pipefail

environment_file="$HOME/.config/uu-remote-bridge/environment"
saved_setting() {
    local name="$1"

    [[ -f "$environment_file" ]] || return 0
    /usr/bin/sed -n "s/^${name}=//p" "$environment_file" | \
        /usr/bin/tail -n 1
}
saved_wine_prefix="$(saved_setting UURB_WINEPREFIX)"
saved_wine_bin="$(saved_setting UURB_WINE_BIN)"
saved_wineserver_bin="$(saved_setting UURB_WINESERVER_BIN)"
saved_uu_audio="$(saved_setting UURB_UU_AUDIO)"
export WINEPREFIX="${WINEPREFIX:-${saved_wine_prefix:-$HOME/.local/share/wineprefixes/uu-remote}}"
export WINEDEBUG="${WINEDEBUG:--all}"

wine_bin="${WINE_BIN:-${UURB_WINE_BIN:-${saved_wine_bin:-/opt/wine-stable/bin/wine}}}"
wineserver_bin="${WINESERVER_BIN:-${UURB_WINESERVER_BIN:-${saved_wineserver_bin:-/opt/wine-stable/bin/wineserver}}}"
uu_audio_setting="${UURB_UU_AUDIO:-${saved_uu_audio:-system}}"
audio_alsa_config="${UURB_UU_AUDIO_ALSA_CONFIG:-$HOME/.config/uu-remote-bridge/alsa-null.conf}"
if [[ "$uu_audio_setting" == off ]]; then
    [[ -r "$audio_alsa_config" ]] || {
        printf 'UU Remote silent-audio configuration is missing; rerun the installer.\n' >&2
        exit 1
    }
    export ALSA_CONFIG_PATH="$audio_alsa_config"
    export WINEDLLOVERRIDES='winebth.sys=d;winepulse.drv=d;winedbg.exe=d;winemenubuilder.exe=d;mscoree,mshtml='
    export PULSE_SERVER="unix:${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge/no-pulse"
    export PIPEWIRE_REMOTE=uu-remote-disabled
    export SDL_AUDIODRIVER=dummy
elif [[ "$uu_audio_setting" == system ]]; then
    export WINEDLLOVERRIDES='winebth.sys=d;winedbg.exe=d;winemenubuilder.exe=d;mscoree,mshtml='
else
    printf 'UU Remote audio mode must be off or system.\n' >&2
    exit 2
fi
if [[ "$WINEPREFIX" != /* || "$wine_bin" != /* ||
      "$wineserver_bin" != /* || ! -x "$wine_bin" ||
      ! -x "$wineserver_bin" ]]; then
    printf 'UU Remote Wine runtime is unavailable; rerun the installer.\n' >&2
    exit 1
fi
wine_stop_bin="$HOME/.local/libexec/uu-remote-stop-wine-prefix"
connection_status_bin="$HOME/.local/libexec/uu-connection-status"
registry_cleaner_bin="$HOME/.local/libexec/uu-clean-wine-device-registry"
console_bin="$HOME/.local/bin/uu-remote-console"
app_dir="$WINEPREFIX/drive_c/Program Files/Netease/GameViewer"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/uu-remote"
systemctl_user=(
    /usr/bin/env
    "DBUS_SESSION_BUS_ADDRESS=unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    /usr/bin/systemctl --user
)

notify_error() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send 'UU Remote' "$1"
    fi
    printf '%s\n' "$1" >&2
}

mkdir -p "$state_dir"

case "${1:-open}" in
    control)
        shift || true
        if (($# != 0)); then
            printf 'uu-remote control does not take options.\n' >&2
            exit 2
        fi
        if [[ -z "${DISPLAY:-}" || ! -x /usr/bin/xmessage ]]; then
            notify_error 'Control mode needs a visible Ubuntu desktop and xmessage.'
            exit 1
        fi
        if ! /usr/bin/xmessage -center \
            -title 'UU Remote Controller' \
            -buttons 'Continue:0,Cancel:1' -default Cancel \
            'Control mode temporarily disconnects this Ubuntu host from UU. If you are connected to this host through UU, choose Cancel. The host service restarts after you close the controller. Continue?'; then
            exit 0
        fi
        exec "$0" login
        ;;
    status)
        exec "${systemctl_user[@]}" status uu-remote-bridge.service --no-pager
        ;;
    restart)
        exec "${systemctl_user[@]}" restart uu-remote-bridge.service
        ;;
    stop)
        exec "${systemctl_user[@]}" stop uu-remote-bridge.service
        ;;
    logs)
        exec journalctl --user -fu uu-remote-bridge.service
        ;;
    network)
        exec /usr/bin/python3 "$connection_status_bin"
        ;;
    repair-registry)
        if [[ ! -x "$registry_cleaner_bin" ]]; then
            notify_error 'The Wine device-registry repair helper is not installed.'
            exit 1
        fi
        exec /usr/bin/env WINE_BIN="$wine_bin" WINESERVER_BIN="$wineserver_bin" \
            "$registry_cleaner_bin" --manage-service "$WINEPREFIX"
        ;;
    update)
        shift || true
        if [[ ! -x "$HOME/.local/bin/uu-remote-update" ]]; then
            notify_error 'UU automatic maintenance is not enabled.'
            exit 1
        fi
        if (($# == 0)); then
            set -- status
        fi
        exec "$HOME/.local/bin/uu-remote-update" "$@"
        ;;
    upgrade)
        shift || true
        if [[ ! -x "$HOME/.local/bin/uu-remote-upgrade" ]]; then
            notify_error 'The reusable UU upgrader is not installed.'
            exit 1
        fi
        exec "$HOME/.local/bin/uu-remote-upgrade" "$@"
        ;;
    login)
        shift || true
        if [[ -z "${DISPLAY:-}" ]]; then
            notify_error 'Run account login from a visible desktop terminal.'
            exit 1
        fi
        if [[ ! -f "$app_dir/GameViewer.exe" ]]; then
            notify_error 'UU Remote is not installed in the bridge Wine prefix.'
            exit 1
        fi
        "${systemctl_user[@]}" stop uu-remote-bridge.service
        "$wine_stop_bin" "$WINEPREFIX" "$wineserver_bin"
        restart_bridge() {
            "$wine_stop_bin" "$WINEPREFIX" "$wineserver_bin" || true
            "${systemctl_user[@]}" start uu-remote-bridge.service
        }
        trap restart_bridge EXIT
        cd "$app_dir"
        "$wine_bin" GameViewer.exe "$@" >>"$state_dir/client.log" 2>&1
        exit 0
        ;;
    open)
        shift || true
        if [[ -z "${DISPLAY:-}" ]]; then
            notify_error 'Open UU Remote from a logged-in graphical desktop.'
            exit 1
        fi
        if [[ ! -f "$app_dir/GameViewer.exe" ]]; then
            notify_error 'UU Remote is not installed in the bridge Wine prefix.'
            exit 1
        fi
        if [[ ! -x "$console_bin" ]]; then
            notify_error 'The UU Remote window helper is not installed.'
            exit 1
        fi
        exec "$console_bin" window "$@"
        ;;
    wake-private)
        # Reinvoke UU's single-instance activation to restore its hidden
        # tray window. Mapping the X window alone leaves Qt's backing store
        # hidden and produces a black canvas after the inner close button.
        bridge_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge"
        read -r bridge_display <"$bridge_runtime_dir/private-display"
        [[ "$bridge_display" =~ ^:(0|[1-9][0-9]{0,2})$ ]] || exit 1
        if [[ -r "$bridge_runtime_dir/controller-display" ]]; then
            read -r controller_display <"$bridge_runtime_dir/controller-display"
            [[ "$controller_display" == "$bridge_display.1" ]] || exit 1
            bridge_display="$controller_display"
        fi
        cd "$app_dir"
        exec /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_runtime_dir/Xauthority" \
            "$wine_bin" "$app_dir/GameViewer.exe"
        ;;
    protocol)
        shift || true
        if (($# != 1)) || [[ "${1,,}" != uuremote:* ]]; then
            printf 'usage: uu-remote protocol uuremote://...\n' >&2
            exit 2
        fi
        if [[ ! -f "$app_dir/GameViewer.exe" ]]; then
            notify_error 'UU Remote is not installed in the bridge Wine prefix.'
            exit 1
        fi
        "${systemctl_user[@]}" start uu-remote-bridge.service
        bridge_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge"
        bridge_display_file="$bridge_runtime_dir/private-display"
        bridge_xauthority="$bridge_runtime_dir/Xauthority"
        bridge_display=""
        for _ in {1..160}; do
            if [[ -r "$bridge_display_file" && -r "$bridge_xauthority" ]]; then
                read -r bridge_display <"$bridge_display_file" || true
                if [[ "$bridge_display" =~ ^:(0|[1-9][0-9]{0,2})$ ]] &&
                   /usr/bin/env DISPLAY="$bridge_display" \
                       XAUTHORITY="$bridge_xauthority" \
                       /usr/bin/xdpyinfo >/dev/null 2>&1; then
                    break
                fi
            fi
            bridge_display=""
            sleep 0.25
        done
        if [[ -z "$bridge_display" ]]; then
            notify_error 'The UU private desktop did not become ready.'
            exit 1
        fi
        if [[ -r "$bridge_runtime_dir/controller-display" ]]; then
            read -r controller_display <"$bridge_runtime_dir/controller-display"
            [[ "$controller_display" == "$bridge_display.1" ]] || exit 1
            bridge_display="$controller_display"
        fi
        cd "$app_dir"
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            "$wine_bin" "$app_dir/GameViewer.exe" "$1" \
                >>"$state_dir/protocol.log" 2>&1
        ;;
    console)
        shift || true
        if [[ ! -x "$console_bin" ]]; then
            notify_error 'The local UU Remote console is not installed.'
            exit 1
        fi
        exec "$console_bin" open "$@"
        ;;
    *)
        printf 'usage: uu-remote [open|control|console|protocol|login|status|network|repair-registry|restart|stop|logs|update|upgrade]\n' >&2
        exit 2
        ;;
esac
